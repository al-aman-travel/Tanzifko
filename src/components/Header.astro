---
import { business } from '../data/business';
import { containers } from '../lib/content';
import { Image } from 'astro:assets';
import { href } from '../lib/url';
import logo from '../assets/logo-horizontal.png';

export interface Props {
  lang?: 'ar' | 'en';
  /** رابط الصفحة نفسها باللغة الأخرى؛ إن لم يوجد يذهب زر اللغة إلى رئيسية اللغة الأخرى */
  switchHref?: string;
}
const { lang = 'ar', switchHref } = Astro.props;
const isEn = lang === 'en';
const list = await containers();
const nav = isEn
  ? [
      ...list.map((c) => ({ href: href(`/en/${c.data.enSlug}/`), label: c.data.titleEn })),
      { href: href('/en/contractors/'), label: 'For contractors' },
      { href: href('/en/our-work/'), label: 'Our work' },
    ]
  : [
      ...list.map((c) => ({ href: href(`/${c.id}/`), label: c.data.title })),
      { href: href('/hawiyat-lilmuqawilin/'), label: 'للمقاولين والشركات' },
      { href: href('/aamaluna/'), label: 'أعمالنا' },
    ];
const home = href(isEn ? '/en/' : '/');
const other = switchHref ?? href(isEn ? '/' : '/en/');
const request = href(isEn ? '/en/request/' : '/talab-hawiya/');
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 bg-white/95 backdrop-blur">
  <div class="stripe" aria-hidden="true"></div>
  <div class="container-page flex items-center justify-between gap-3 py-3">
    <a href={home} class="flex shrink-0 items-center" aria-label={isEn ? `${business.shortEn} — Home` : `${business.short} — الرئيسية`}>
      <Image src={logo} alt={`${business.short} — ${business.shortEn}`} widths={[180, 360, 540]} sizes="180px" class="h-11 w-auto" loading="eager" />
    </a>
    <nav aria-label={isEn ? 'Main menu' : 'القائمة الرئيسية'} class="hidden gap-5 text-sm font-semibold lg:flex">
      {nav.map((l) => (
        <a href={l.href} class:list={['hover:text-brand', path.startsWith(l.href) && 'text-brand underline underline-offset-8']}>{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={other} hreflang={isEn ? 'ar' : 'en'} lang={isEn ? 'ar' : 'en'} class="btn btn-line px-3 py-2 text-sm">{isEn ? 'العربية' : 'English'}</a>
      <a href={request} class="btn btn-sun hidden px-3 py-2 text-sm sm:inline-flex">{isEn ? 'Order a container' : 'اطلب حاوية'}</a>
      <details class="relative lg:hidden">
        <summary class="btn btn-line cursor-pointer list-none px-3 py-2 text-sm" aria-label={isEn ? 'Menu' : 'القائمة'}>☰</summary>
        <nav class:list={['absolute z-40 mt-2 w-60 rounded-lg border border-line bg-white p-2 shadow-lg', isEn ? 'right-0' : 'left-0']}>
          {nav.map((l) => <a href={l.href} class="block rounded px-3 py-2 hover:bg-sand">{l.label}</a>)}
          <a href={request} class="mt-1 block rounded bg-sun px-3 py-2 font-bold">{isEn ? 'Order a container' : 'اطلب حاوية'}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
