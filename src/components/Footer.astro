---
import { business, description, descriptionEn } from '../data/business';
import { waGeneral, waGeneralEn } from '../data/whatsapp';
import { containers } from '../lib/content';
import { href } from '../lib/url';

export interface Props { lang?: 'ar' | 'en' }
const isEn = Astro.props.lang === 'en';
const list = await containers();
const year = new Date().getFullYear();
const phones = [...new Set([business.phone, ...business.extraPhones])].filter((p) => p && p !== business.whatsapp);
const hours = isEn ? business.openingHoursTextEn : business.openingHoursText;
const address = isEn ? business.addressEn : business.address;
---
<footer class="mt-16 bg-brand-dark text-sm text-white/90">
  <div class="stripe" aria-hidden="true"></div>
  <div class="container-page grid gap-8 py-10 md:grid-cols-3">
    <div>
      <a href={href(isEn ? '/en/' : '/')} class="text-base font-bold text-white">{isEn ? business.nameEn : business.name}</a>
      <p class="mt-2 text-white/75">{isEn ? descriptionEn : description}</p>
    </div>
    <div>
      <p class="font-bold text-white">{isEn ? 'Containers' : 'الحاويات'}</p>
      <ul class="mt-2 space-y-1">
        {list.map((c) => <li><a class="hover:text-sun" href={href(isEn ? `/en/${c.data.enSlug}/` : `/${c.id}/`)}>{isEn ? c.data.titleEn : c.data.title}</a></li>)}
        <li><a class="hover:text-sun" href={href(isEn ? '/en/contractors/' : '/hawiyat-lilmuqawilin/')}>{isEn ? 'For contractors and companies' : 'حاويات للمقاولين والشركات'}</a></li>
        <li><a class="hover:text-sun" href={href(isEn ? '/en/our-work/' : '/aamaluna/')}>{isEn ? 'Our work' : 'أعمالنا'}</a></li>
        <li><a class="hover:text-sun" href={href(isEn ? '/en/request/' : '/talab-hawiya/')}>{isEn ? 'Order a container' : 'اطلب حاوية'}</a></li>
      </ul>
    </div>
    <address class="not-italic">
      <p class="font-bold text-white">{isEn ? 'Contact' : 'التواصل'}</p>
      {address && <p class="mt-2">{business.mapUrl ? <a class="hover:text-sun" href={business.mapUrl} target="_blank" rel="noopener">{address}</a> : address}</p>}
      {hours && <p class="mt-1">{hours}</p>}
      <p class="mt-2">{isEn ? 'WhatsApp: ' : 'واتساب: '}<a dir="ltr" class="font-bold text-white" href={`https://wa.me/965${business.whatsapp}`}>{business.whatsapp}</a></p>
      {business.phone === business.whatsapp && <p class="mt-1">{isEn ? 'Phone: ' : 'الهاتف: '}<a dir="ltr" class="font-bold text-white" href={`tel:+965${business.phone}`}>{business.phone}</a></p>}
      {phones.map((p) => <p class="mt-1">{isEn ? 'Phone: ' : 'الهاتف: '}<a dir="ltr" class="font-bold text-white" href={`tel:+965${p}`}>{p}</a></p>)}
      {business.email && <p class="mt-1"><a class="hover:text-sun" href={`mailto:${business.email}`}>{business.email}</a></p>}
      <a class="btn btn-wa mt-3 px-4 py-2" href={isEn ? waGeneralEn() : waGeneral()} target="_blank" rel="noopener">{isEn ? 'Order on WhatsApp' : 'اطلب عبر واتساب'}</a>
    </address>
  </div>
  <div class="border-t border-white/15 py-4 text-center text-white/70">© {year} {isEn ? business.nameEn : business.name}</div>
</footer>
