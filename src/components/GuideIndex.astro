---
/** فهرس الدليل — قالب واحد للعربية والإنجليزية */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { business } from '../data/business';
import { waGeneral, waGeneralEn } from '../data/whatsapp';
import { guidePairs, guidePath, guidePathEn } from '../lib/content';
import { href } from '../lib/url';

export interface Props { lang?: 'ar' | 'en' }
const isEn = Astro.props.lang === 'en';
const pairs = (await guidePairs()).filter((p) => !isEn || p.en);
const path = isEn ? '/en/guides/' : '/dalil/';
const crumbs = [{ name: isEn ? 'Home' : 'الرئيسية', path: isEn ? '/en/' : '/' }, { name: isEn ? 'Guides' : 'الدليل', path }];
const fmt = (dt: Date) => new Intl.DateTimeFormat(isEn ? 'en-GB' : 'ar-KW-u-nu-latn-ca-gregory', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kuwait' }).format(dt);
---
<BaseLayout
  lang={isEn ? 'en' : 'ar'}
  title={isEn ? 'Rubble container guides: prices, renovation and waste sorting in Kuwait' : 'دليل حاويات الأنقاض في الكويت: الأسعار والترميم وفرز المخلفات'}
  description={isEn
    ? `Short guides from ${business.nameEn} on renting rubble and construction waste containers in Kuwait: what sets the price, preparing for a renovation, and sorting waste.`
    : `مقالات قصيرة من ${business.name} عن تأجير حاويات الأنقاض ومخلفات البناء في الكويت: ما يحدد السعر، وتجهيز رفع أنقاض الترميم، وفرز المخلفات.`}
  breadcrumbs={crumbs}
  alternate={isEn ? '/dalil/' : '/en/guides/'}
  pageType="CollectionPage"
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} lang={isEn ? 'en' : 'ar'} />
    <h1 class="mt-4 text-3xl font-bold leading-snug">{isEn ? 'Rubble container guides for Kuwait' : 'دليل حاويات الأنقاض ومخلفات البناء في الكويت'}</h1>
    <p class="mt-4 max-w-3xl text-lg">{isEn ? 'Practical answers before you order a container: what sets the price, how to prepare for a renovation, and which container fits each type of waste.' : 'إجابات عملية قبل أن تطلب الحاوية: ما الذي يحدد السعر، وكيف تجهّز رفع أنقاض الترميم، وأي حاوية تناسب كل نوع من المخلفات.'}</p>
    <ul class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {pairs.map((p) => {
        const t = isEn ? p.en!.data : p.ar.data;
        return (
          <li class="flex flex-col overflow-hidden rounded-2xl border border-line bg-white">
            <Image src={p.ar.data.image} alt={isEn ? p.ar.data.imageAltEn ?? p.ar.data.imageAlt : p.ar.data.imageAlt} widths={[400, 640]} sizes="(min-width: 1024px) 22rem, (min-width: 768px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            <div class="flex flex-1 flex-col p-5">
              <h2 class="text-lg font-bold leading-snug"><a class="hover:text-brand" href={href(isEn ? guidePathEn(p.en!) : guidePath(p.ar))}>{t.title}</a></h2>
              <p class="mt-2 flex-1 text-sm text-muted">{t.description}</p>
              <p class="mt-3 text-xs text-muted"><time datetime={p.ar.data.date.toISOString()}>{fmt(p.ar.data.date)}</time></p>
            </div>
          </li>
        );
      })}
    </ul>
    <section class="mt-12 rounded-2xl bg-brand p-6 text-white md:p-8">
      <h2 class="text-2xl font-bold">{isEn ? 'Need a container on site?' : 'تحتاج حاوية لموقع العمل؟'}</h2>
      <p class="mt-2 text-white/85">{isEn ? 'Send the work area and the waste type on WhatsApp and we will confirm availability and the delivery time.' : 'أرسل منطقة العمل ونوع المخلفات عبر واتساب، ونؤكد لك التوفر وموعد التوصيل.'}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a class="btn btn-sun" href={href(isEn ? '/en/request/' : '/talab-hawiya/')}>{isEn ? 'Request form' : 'نموذج الطلب'}</a>
        <a class="btn btn-wa" href={isEn ? waGeneralEn() : waGeneral()} target="_blank" rel="noopener">{isEn ? 'WhatsApp' : 'واتساب'} {business.whatsapp}</a>
      </div>
    </section>
  </div>
</BaseLayout>
