---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { business, description as descAr, descriptionEn } from '../data/business';
import { href, abs } from '../lib/url';
import { PREVIEW, STATS_API } from '../../site.config.mjs';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  /** صورة الواجهة (أكبر عنصر في أول الشاشة) — تُحمَّل مبكرًا لتحسين LCP */
  preloadImage?: { src: string; srcset?: string; sizes?: string };
  faqs?: { question: string; answer: string }[];
  /** مسار الصفحة: path بدون مسار المعاينة، مثل '/hawiyat-anqad/' */
  breadcrumbs?: { name: string; path: string }[];
  service?: { name: string; url: string; description?: string; image?: string };
  lang?: 'ar' | 'en';
  /** نوع الصفحة لجوجل: WebPage (افتراضي) أو AboutPage أو ContactPage */
  pageType?: string;
  /** مسار الصفحة المقابلة باللغة الأخرى (يبدأ بـ / ومن دون مسار المعاينة) */
  alternate?: string;
}
const { title, description, noindex = false, ogImage, preloadImage, faqs, breadcrumbs, service, lang = 'ar', alternate, pageType } = Astro.props;
const isEn = lang === 'en';
const brand = isEn ? business.shortEn : business.short;
const fullTitle = title.includes(brand) ? title : `${title} | ${brand}`;
const metaDescription = description?.trim() ? description : isEn ? descriptionEn : descAr;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = ogImage ? new URL(ogImage, Astro.site).toString() : abs('/og-image.jpg', Astro.site);
const altUrl = alternate ? abs(alternate, Astro.site) : undefined;
const arUrl = isEn ? altUrl : canonical;
const enUrl = isEn ? canonical : altUrl;
// رابط المعاينة (قبل الدومين) لا يُفهرس أبدًا
const robots = noindex || PREVIEW ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1';
const indexable = !noindex && !PREVIEW;
const f = (w: number, sub: 'arabic' | 'latin') => href(`/fonts/cairo-${sub}-${w}-normal.woff2`);
const AR = 'U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF';
const LAT = 'U+0000-00FF, U+2000-206F, U+2190-21FF, U+00B2-00B3, U+00D7';
const fonts = [400, 600, 700]
  .flatMap((w) => [
    `@font-face{font-family:'Cairo';font-weight:${w};font-display:swap;src:url('${f(w, 'arabic')}') format('woff2');unicode-range:${AR}}`,
    `@font-face{font-family:'Cairo';font-weight:${w};font-display:swap;src:url('${f(w, 'latin')}') format('woff2');unicode-range:${LAT}}`,
  ])
  .join('');
---
<!doctype html>
<html lang={isEn ? 'en' : 'ar-KW'} dir={isEn ? 'ltr' : 'rtl'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#03482a" />
    <link rel="icon" href={href('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href={href('/favicon-96.png')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="preload" href={f(700, isEn ? 'latin' : 'arabic')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={f(400, isEn ? 'latin' : 'arabic')} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage.src} imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
    <style set:html={fonts}></style>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {indexable && arUrl && <link rel="alternate" hreflang="ar-KW" href={arUrl} />}
    {indexable && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {indexable && arUrl && <link rel="alternate" hreflang="x-default" href={arUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isEn ? 'en_US' : business.locale} />
    <meta property="og:site_name" content={isEn ? business.nameEn : business.name} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <Schema faqs={faqs} breadcrumbs={breadcrumbs?.map((b) => ({ name: b.name, url: abs(b.path, Astro.site) }))} service={service} lang={lang} title={fullTitle} description={metaDescription} image={og} pageType={pageType} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">{isEn ? 'Skip to content' : 'تخطَّ إلى المحتوى'}</a>
    <Header lang={lang} switchHref={alternate ? href(alternate) : undefined} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <FloatingWhatsApp lang={lang} />
    {!PREVIEW && !noindex && (
      <script is:inline define:vars={{ api: STATS_API + '/api/e' }}>
        // إحصائيات خفيفة بلا كوكيز: تُرسل بعد اكتمال تحميل الصفحة وفي وقت الفراغ فقط (لا تؤثر على LCP)
        (function () {
          try { if (localStorage.getItem('tz-notrack') === '1') return; } catch (e) {}
          if (!/(^|\.)hawiyatkw\.com$/.test(location.hostname) || navigator.webdriver) return;
          var send = function (t, l, h) {
            var d = JSON.stringify({ t: t, p: location.pathname, l: (l || '').slice(0, 60), h: h || '', r: document.referrer, w: innerWidth });
            try { navigator.sendBeacon ? navigator.sendBeacon(api, d) : fetch(api, { method: 'POST', body: d, keepalive: true }); } catch (e) {}
          };
          var idle = window.requestIdleCallback || function (f) { setTimeout(f, 1500); };
          var pv = function () { idle(function () { send('pv'); }); };
          document.readyState === 'complete' ? pv() : addEventListener('load', pv, { once: true });
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a,button,summary');
            if (!a) return;
            var h = a.getAttribute('href') || '';
            var l = (a.getAttribute('data-track') || a.getAttribute('aria-label') || a.textContent || '').replace(/\s+/g, ' ').trim();
            var t = 'click';
            if (/wa\.me|whatsapp/.test(h)) t = 'wa';
            else if (h.indexOf('tel:') === 0) t = 'call';
            else if (/\/talab-hawiya\/|\/en\/request\//.test(h)) t = 'cta';
            else if (a.closest('form[data-wa-form]')) return; // زر إرسال النموذج يُسجَّل في submit
            var dest = h;
            try { var u = new URL(h, location.href); dest = u.host === location.host ? u.pathname : u.host; } catch (e) {}
            send(t, l, dest);
          }, { capture: true, passive: true });
          document.addEventListener('submit', function (e) {
            if (e.target.matches && e.target.matches('form[data-wa-form]')) send('order', 'نموذج الطلب', 'wa.me');
          }, true);
        })();
      </script>
    )}
  </body>
</html>
