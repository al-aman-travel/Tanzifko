---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/url';
---
<BaseLayout title="الصفحة غير موجودة" noindex>
  <section class="container-page py-20 text-center">
    <h1 class="text-3xl font-bold">الصفحة غير موجودة</h1>
    <p class="mt-3 text-muted">ربما تغيّر الرابط. ارجع للرئيسية أو اطلب حاوية مباشرة.</p>
    <p class="mt-1 text-muted" lang="en" dir="ltr">Page not found.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a class="btn btn-brand" href={href('/')}>الرئيسية</a>
      <a class="btn btn-line" href={href('/talab-hawiya/')}>اطلب حاوية</a>
    </div>
  </section>
  <!-- أي رابط يبدأ بـ /adm (خطأ كتابة أو بدون .html) يُحوَّل إلى صفحة لوحة التحكم الصحيحة -->
  <script is:inline define:vars={{ base: href('/admin/') }}>
    (function () {
      var p = decodeURIComponent(location.pathname).toLowerCase();
      if (!/^\/+a[a-z]{0,2}m/.test(p)) return; // admin / admn / adim / amin …
      var t = base + (/stat|احص|إحص/.test(p) ? 'stats.html' : /set|تجهيز/.test(p) ? 'setup.html' : '');
      if (t !== location.pathname) location.replace(t);
    })();
  </script>
</BaseLayout>
