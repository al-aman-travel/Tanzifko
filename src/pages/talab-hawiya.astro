---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RequestForm from '../components/RequestForm.astro';
import { business } from '../data/business';

const crumbs = [{ name: 'الرئيسية', path: '/' }, { name: 'اطلب حاوية', path: '/talab-hawiya/' }];
---
<BaseLayout
  title="اطلب حاوية أنقاض أو مخلفات عبر واتساب"
  description={`اطلب حاوية من ${business.name}: اختر المقاس واكتب منطقة العمل، وتصلنا الرسالة على واتساب ${business.whatsapp}.`}
  breadcrumbs={crumbs}
  alternate="/en/request/"
>
  <div class="container-page max-w-3xl pt-6">
    <Breadcrumbs items={crumbs} />
    <h1 class="mt-4 text-3xl font-bold">اطلب حاوية</h1>
    <p class="mt-3 text-muted">اختر الحاوية واكتب منطقة العمل، ثم اضغط الزر لتُفتح رسالة واتساب جاهزة إلى {business.whatsapp}.</p>
    <div class="mt-6"><RequestForm /></div>
  </div>
</BaseLayout>
