---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContainerCard from '../../components/ContainerCard.astro';
import Clients from '../../components/Clients.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import FAQ from '../../components/FAQ.astro';
import { business, operations, licenseTextEn, custom, contractsFaqEn } from '../../data/business';
import { href } from '../../lib/url';
import { waLink } from '../../data/whatsapp';
import { containers } from '../../lib/content';
import { projectTypes, newCities } from '../../data/areas';

const list = await containers();
const crumbs = [{ name: 'Home', path: '/en/' }, { name: 'Contractors and projects', path: '/en/contractors/' }];
const sectors = ['Construction contractors', 'Engineering contractors', 'Renovation and finishing companies', 'Shops, warehouses and workshops', 'Home and villa owners'];
const faqs = [
  contractsFaqEn,
  { question: 'Do you work under contract with contracting companies?', answer: 'Yes. We have contracts with major contracting companies in Kuwait and track record with renovation, engineering contracting and finishing companies.' },
  { question: 'Do you supply skips for demolition and new-build projects?', answer: 'Yes. We supply skips for new construction, demolition, renovation and finishing projects, and swap them when full for the whole project.' },
  { question: 'Which containers suit construction sites?', answer: 'The 12 m³ rubble container for bricks, marble and construction waste, and the 30 m³ container for wood, cardboard and tyres.' },
  { question: 'How do we order containers for a project?', answer: `Message us on WhatsApp +965 ${business.whatsapp} with the company name, project location, waste types and the expected number of containers.` },
];
const wa = waLink(`Hello ${business.shortEn}, we are a company and need containers for a project.\nCompany:\nProject location:\nWaste type:\nNumber of containers:`);
---
<BaseLayout
  lang="en"
  title="Skip hire for contractors and construction projects in Kuwait"
  description={`${business.nameEn} rents rubble and waste containers to contracting, renovation and finishing companies in Kuwait, with delivery, swap and pickup.`}
  faqs={faqs}
  breadcrumbs={crumbs}
  alternate="/hawiyat-lilmuqawilin/"
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} lang="en" />
    <h1 class="mt-4 text-3xl font-bold leading-snug">Skip and rubble container hire for contractors and projects in Kuwait</h1>
    <p class="mt-4 max-w-3xl text-lg">We rent rubble and waste containers for construction, renovation and finishing sites. We deliver the containers, swap them when full and collect them when the work is done.</p>
    <section class="mt-10">
      <h2 class="text-2xl font-bold">Contracts and track record</h2>
      <p class="mt-2 max-w-3xl">We have contracts with major contracting companies in Kuwait and track record with renovation, engineering contracting and finishing companies, including:</p>
      <Clients lang="en" />
    </section>
    {licenseTextEn && (
      <section class="mt-12 rounded-2xl border border-line bg-white p-6">
        <h2 class="text-2xl font-bold">Licence and approvals</h2>
        <p class="mt-2 max-w-3xl">{business.nameEn}: {licenseTextEn}</p>
      </section>
    )}
    <section class="mt-12 rounded-2xl border-2 border-sun bg-white p-6">
      <h2 class="text-2xl font-bold">Monthly and annual contracts</h2>
      <p class="mt-2 max-w-3xl">We offer monthly and annual contracts to supply and swap skips for the whole project, as well as one-off orders.</p>
      <a class="btn btn-wa mt-4" href={wa} target="_blank" rel="noopener">Request a contract quote on WhatsApp</a>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Skips for every type of project</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projectTypes.map((t) => <li class="rounded-xl border border-line bg-white p-5"><h3 class="font-bold">{t.en}</h3><p class="mt-1 text-sm text-muted">{t.textEn}</p></li>)}
      </ul>
      <p class="mt-4 max-w-3xl">We also supply projects in the new residential cities: {newCities.map((c) => c.en).join(', ')} — <a class="font-semibold text-brand underline" href={href('/en/service-areas/')}>all service areas</a>.</p>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Who we work with</h2>
      <ul class="mt-4 flex flex-wrap gap-2">{sectors.map((s) => <li class="rounded-full border border-line bg-white px-3 py-1 font-semibold">{s}</li>)}</ul>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Available containers</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{list.map((c) => <ContainerCard c={c} lang="en" />)}</div>
      <p class="mt-4">If your company needs a different size, <a class="font-bold text-brand underline" href={href(custom.pathEn)}>we design and build the container to your size</a>.</p>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">What we provide</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-3">
        {operations.map((o) => <li class="rounded-xl border border-line bg-white p-5"><h3 class="font-bold">{o.titleEn}</h3><p class="mt-1 text-sm text-muted">{o.textEn}</p></li>)}
      </ul>
    </section>
    <ServiceAreas lang="en" />
    <FAQ faqs={faqs} title="Frequently asked questions" />
    <a class="btn btn-wa mt-10" href={wa} target="_blank" rel="noopener">Message us on WhatsApp</a>
  </div>
</BaseLayout>
