---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContainerCard from '../../components/ContainerCard.astro';
import FAQ from '../../components/FAQ.astro';
import { business, custom } from '../../data/business';
import { waGeneralEn } from '../../data/whatsapp';
import { containers, dims } from '../../lib/content';
import { href } from '../../lib/url';

const list = await containers();
const crumbs = [{ name: 'Home', path: '/en/' }, { name: 'Container sizes', path: '/en/container-sizes/' }];
const faqs = [
  { question: 'Which container sizes does Tanzeefko Local offer?', answer: 'A 12 m³ rubble container for bricks, marble and construction waste, and a 30 m³ container (6 × 2.30 × 2.10 m) for wood, cardboard and tyres. We also build containers in other sizes on request.' },
  { question: 'What is the difference between the 12 m³ and 30 m³ containers?', answer: 'The 12 m³ container is for heavy waste such as rubble, bricks and marble. The 30 m³ container is for bulky, lighter waste such as wood, cardboard and tyres.' },
  { question: 'Do you have 6 m³ or 14 m³ skips?', answer: 'Our standard sizes are 12 m³ and 30 m³. If your company needs another size, we build the container to order.' },
  { question: 'How do I choose the right size?', answer: `Choose by the type of waste first. If you are not sure, send the type of work and the area on WhatsApp +965 ${business.whatsapp} and we will suggest a size.` },
  { question: 'What if the container fills up before the work is done?', answer: 'We take the full container away and leave an empty one, and collect it when the work is finished.' },
];
---
<BaseLayout
  lang="en"
  title="Skip sizes in Kuwait: 12 m³ vs 30 m³ rubble containers"
  description={`Container size guide from ${business.nameEn}: a 12 m³ container for bricks and marble, a 30 m³ container (6 × 2.30 × 2.10 m) for wood and cardboard, and custom sizes on request.`}
  faqs={faqs}
  breadcrumbs={crumbs}
  alternate="/maqasat-hawiyat/"
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} lang="en" />
    <h1 class="mt-4 text-3xl font-bold leading-snug">Skip and rubble container sizes in Kuwait: which one fits your project?</h1>
    <p class="mt-4 max-w-3xl text-lg">The right size depends on the type of waste before its amount. Here is a comparison of the containers we rent, so you order the right one the first time.</p>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-line bg-white">
      <table class="w-full min-w-[34rem] text-left text-sm md:text-base">
        <caption class="sr-only">Container size comparison</caption>
        <thead class="bg-sand">
          <tr><th scope="col" class="p-3">Container</th><th scope="col" class="p-3">Capacity</th><th scope="col" class="p-3">Size (L × W × H)</th><th scope="col" class="p-3">Suitable waste</th></tr>
        </thead>
        <tbody class="divide-y divide-line">
          {list.map((c) => (
            <tr>
              <th scope="row" class="p-3"><a class="text-brand underline" href={href(`/en/${c.data.enSlug}/`)}>{c.data.titleEn}</a></th>
              <td class="p-3">{c.data.capacity} m³</td>
              <td class="p-3">{dims(c, true) || '—'}</td>
              <td class="p-3">{c.data.acceptsEn.join(', ')}</td>
            </tr>
          ))}
          <tr>
            <th scope="row" class="p-3"><a class="text-brand underline" href={href(custom.pathEn)}>{custom.titleEn}</a></th>
            <td class="p-3">Any size requested</td><td class="p-3">To order</td><td class="p-3">By use</td>
          </tr>
        </tbody>
      </table>
    </div>
    <section class="prose-ar mt-10 max-w-3xl">
      <h2>Heavy waste: the 12 m³ container</h2>
      <p>Rubble, bricks, marble and construction and renovation waste are heavy, so they go in the 12 m³ rubble container. It suits demolition, renovation and finishing work on homes, villas and construction sites.</p>
      <h2>Bulky waste: the 30 m³ container</h2>
      <p>Wood, cardboard and tyres take up a lot of space but weigh less, so they go in the 30 m³ container, 6 m long, 2.30 m wide and 2.10 m high.</p>
      <h2>Large projects or ongoing waste</h2>
      <p>Instead of ordering a bigger container, we swap the container for an empty one whenever it is full. If your company needs a different size, <a href={href(custom.pathEn)}>we design and build the container to your size</a>.</p>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Available containers</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2">{list.map((c) => <ContainerCard c={c} lang="en" />)}</div>
    </section>
    <FAQ faqs={faqs} title="Frequently asked questions" />
    <a class="btn btn-wa mt-10" href={waGeneralEn()} target="_blank" rel="noopener">Ask us about the right size on WhatsApp</a>
  </div>
</BaseLayout>
