---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ContainerCard from '../../components/ContainerCard.astro';
import FAQ from '../../components/FAQ.astro';
import TrustBar from '../../components/TrustBar.astro';
import { business, operations, areasFaqEn, priceFaqEn } from '../../data/business';
import { governorateAreas, newCities, industrialAreas } from '../../data/areas';
import { waLink } from '../../data/whatsapp';
import { containers } from '../../lib/content';
import { href } from '../../lib/url';

const list = await containers();
const crumbs = [{ name: 'Home', path: '/en/' }, { name: 'Service areas', path: '/en/service-areas/' }];
const faqs = [
  areasFaqEn,
  { question: 'Do you deliver skips to new residential cities such as Mutlaa and Jaber Al-Ahmad?', answer: 'Yes. We deliver containers to every area of Kuwait, including the new residential cities: Mutlaa, Jaber Al-Ahmad, Sabah Al-Ahmad, Khairan and Abdullah Al-Mubarak.' },
  { question: 'Do you serve industrial areas?', answer: 'Yes, including Shuwaikh Industrial, Al-Rai, Ardiya Craft Area, Amghara, Sulaibiya and Shuaiba Industrial.' },
  { question: 'How do I order a skip for my area?', answer: `Send your area and the type of waste on WhatsApp +965 ${business.whatsapp}, and we will confirm the delivery time.` },
  priceFaqEn(business.whatsapp),
];
const waArea = (area: string) => waLink(`Hello ${business.shortEn}, I need a skip in ${area}.\nWaste type:\nDate:`);
---
<BaseLayout
  lang="en"
  title="Skip hire in all areas of Kuwait — all six governorates"
  description={`${business.nameEn} delivers rubble skips and waste containers to every area of Kuwait: Capital, Hawalli, Farwaniya, Ahmadi, Jahra and Mubarak Al-Kabeer, plus new cities such as Mutlaa, Jaber Al-Ahmad and Sabah Al-Ahmad.`}
  faqs={faqs}
  breadcrumbs={crumbs}
  alternate="/manatiq-alkhidma/"
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} lang="en" />
    <h1 class="mt-4 text-3xl font-bold leading-snug">Skip and rubble container hire in all areas of Kuwait</h1>
    <p class="mt-4 max-w-3xl text-lg">We deliver, swap and collect rubble skips and waste containers in every area of Kuwait without exception — all six governorates, the new residential cities and the industrial areas. Choose your governorate:</p>
    <nav aria-label="Governorates" class="mt-5 flex flex-wrap gap-2">
      {governorateAreas.map((g) => <a class="btn btn-line px-3 py-2 text-sm" href={`#${g.id}`}>{g.en}</a>)}
    </nav>
    <div class="mt-5"><TrustBar lang="en" tone="light" /></div>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {governorateAreas.map((g) => (
        <section id={g.id} class="scroll-mt-24 rounded-2xl border border-line bg-white p-5">
          <h2 class="text-xl font-bold">Skip hire in {g.en}</h2>
          <p class="mt-2 text-sm text-muted">We serve every area of {g.en}, including:</p>
          <p class="mt-2 leading-8">{g.areas.map((a) => a.en).join(', ')}.</p>
          <a class="mt-3 inline-block font-semibold text-brand underline" href={waArea(g.en)} target="_blank" rel="noopener">Order a skip in {g.en}</a>
        </section>
      ))}
    </div>
    <section class="mt-12 rounded-2xl bg-sand p-6">
      <h2 class="text-2xl font-bold">Rubble skips for the new residential cities</h2>
      <p class="mt-2 max-w-3xl">Construction and finishing work in the new cities needs rubble containers for the whole job. We deliver and swap containers in:</p>
      <ul class="mt-4 flex flex-wrap gap-2">{newCities.map((c) => <li class="rounded-full border border-line bg-white px-3 py-1 font-semibold">{c.en}</li>)}</ul>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Containers for industrial and craft areas</h2>
      <p class="mt-2 max-w-3xl">For cardboard, wood and tyre waste from factories, warehouses and workshops, we supply the <a class="text-brand underline" href={href('/en/container-30m3/')}>30 m³ container</a> in industrial areas, including:</p>
      <ul class="mt-4 flex flex-wrap gap-2">{industrialAreas.map((c) => <li class="rounded-full border border-line bg-white px-3 py-1 font-semibold">{c.en}</li>)}</ul>
    </section>
    <section class="mt-12">
      <h2 class="text-2xl font-bold">Containers available in every area</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2">{list.map((c) => <ContainerCard c={c} lang="en" />)}</div>
      <ul class="mt-6 grid gap-4 sm:grid-cols-3">
        {operations.map((o) => <li class="rounded-xl border border-line bg-white p-5"><h3 class="font-bold">{o.titleEn}</h3><p class="mt-1 text-sm text-muted">{o.textEn}</p></li>)}
      </ul>
    </section>
    <FAQ faqs={faqs} title="Frequently asked questions" />
  </div>
</BaseLayout>
