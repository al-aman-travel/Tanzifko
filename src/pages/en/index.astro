---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContainerCard from '../../components/ContainerCard.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import Clients from '../../components/Clients.astro';
import TrustBar from '../../components/TrustBar.astro';
import ServiceAreas from '../../components/ServiceAreas.astro';
import FAQ from '../../components/FAQ.astro';
import { business, operations, custom, priceFaqEn, areasFaqEn, restaurants, contractsFaqEn } from '../../data/business';
import { waGeneralEn } from '../../data/whatsapp';
import { containers, works } from '../../lib/content';
import { heroImage } from '../../lib/hero';
import { href } from '../../lib/url';
import heroSrc from '../../content/works/images/hawiyat-anqad-anboob-108.jpg';

const list = await containers();
const featured = (await works({ featured: true })).slice(0, 6);
const hero = await heroImage(heroSrc, '(min-width: 1024px) 28rem, 100vw');
const faqs = [
  { question: 'Do you offer skip hire in Kuwait?', answer: 'Yes. We rent hook-lift skips (containers) for rubble and waste in every area of Kuwait, with delivery, swap and pickup.' },
  { question: 'Which container sizes do you have?', answer: 'A 6 m³ skip and a 12 m³ rubble skip for rubble, bricks, marble and construction waste, and a 30 m³ container (6 × 2.30 × 2.1 m) for wood, cardboard and tyres.' },
  { question: 'Do you build containers in custom sizes?', answer: `Yes. We design and build containers to the size your company requests. Send the size and waste type on WhatsApp +965 ${business.whatsapp}.` },
  { question: 'Do you swap the container when it is full?', answer: 'Yes. We take the full container away and leave an empty one, and collect it when the work is finished.' },
  { question: 'How do I order a container?', answer: `On WhatsApp +965 ${business.whatsapp}: send the work area, the type of waste and the date, and we will confirm availability and the delivery time.` },
  areasFaqEn,
  contractsFaqEn,
  priceFaqEn(business.whatsapp),
  { question: 'What are your working hours?', answer: 'Daily, 7 am to 10 pm, every day of the week.' },
  { question: 'Do you work with contracting companies?', answer: 'Yes. We have contracts with major contracting companies in Kuwait and track record with renovation, engineering contracting and finishing companies.' },
];
---
<BaseLayout
  lang="en"
  title={`Skip hire & rubble container rental in Kuwait — ${business.shortEn}`}
  description={`Skip hire in Kuwait from ${business.nameEn}: 6 m³ and 12 m³ rubble skips and 30 m³ skips for wood, cardboard and tyres, delivered, swapped and collected in every area. Order on WhatsApp +965 ${business.whatsapp}.`}
  faqs={faqs}
  alternate="/"
  preloadImage={hero}
>
  <section class="bg-brand text-white">
    <div class="container-page grid items-center gap-8 py-10 lg:grid-cols-[1fr_28rem] lg:py-14">
      <div>
        <p class="font-semibold text-sun">{business.nameEn}</p>
        <h1 class="mt-2 text-3xl font-bold leading-snug md:text-4xl">Skip hire and rubble container rental in Kuwait</h1>
        <p class="mt-4 max-w-2xl text-lg text-white/85">6 m³ and 12 m³ rubble skips for bricks, marble and construction waste, and a 30 m³ skip for wood, cardboard and tyres. We deliver the skip anywhere in Kuwait, swap it when it is full and collect it when the work is done.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-sun" href={href('/en/request/')}>Order a container</a>
          <a class="btn btn-wa" href={waGeneralEn()} target="_blank" rel="noopener">WhatsApp {business.whatsapp}</a>
        </div>
        <div class="mt-6"><TrustBar lang="en" /></div>
      </div>
      <img src={hero.src} srcset={hero.srcset} sizes={hero.sizes} width={hero.width} height={hero.height} alt="Tanzeefko Local rubble container under a debris chute at a building under renovation" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full rounded-2xl object-cover shadow-xl lg:aspect-[3/4]" />
    </div>
  </section>

  <section class="container-page mt-12">
    <h2 class="text-2xl font-bold">Skip and container sizes</h2>
    <p class="mt-1 text-muted">Choose the container by the type of waste, or read our <a class="text-brand underline" href={href('/en/container-sizes/')}>container size guide</a>.</p>
    <div class="mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{list.map((c) => <ContainerCard c={c} lang="en" />)}</div>
    <div class="mt-5 flex flex-col gap-4 rounded-2xl border-2 border-sun bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="text-xl font-bold">{custom.titleEn}</h3>
        <p class="mt-1 text-muted">Need a size other than 6, 12 or 30 m³? {custom.shortEn}</p>
      </div>
      <a class="btn btn-brand shrink-0" href={href(custom.pathEn)}>Custom containers</a>
    </div>
    <div class="mt-4 flex flex-col gap-4 rounded-2xl border border-line bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="text-xl font-bold">{restaurants.titleEn}</h3>
        <p class="mt-1 text-muted">{restaurants.shortEn}</p>
      </div>
      <a class="btn btn-line shrink-0" href={href(restaurants.pathEn)}>Restaurant containers</a>
    </div>
  </section>

  <section class="container-page mt-14">
    <h2 class="text-2xl font-bold">Our services</h2>
    <ol class="mt-5 grid gap-4 sm:grid-cols-3">
      {operations.map((o, i) => (
        <li class="rounded-xl border border-line bg-white p-5">
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sun font-bold">{i + 1}</span>
          <h3 class="mt-3 font-bold">{o.titleEn}</h3>
          <p class="mt-1 text-sm text-muted">{o.textEn}</p>
        </li>
      ))}
    </ol>
  </section>

  <div class="container-page"><ServiceAreas lang="en" /></div>

  <section class="container-page mt-14">
    <div class="rounded-2xl bg-sand p-6 md:p-8">
      <h2 class="text-2xl font-bold">For contractors and renovation companies</h2>
      <p class="mt-2 max-w-3xl">We have contracts with major contracting companies in Kuwait and track record with renovation, engineering contracting and finishing companies, including:</p>
      <Clients lang="en" />
      <a class="btn btn-brand mt-5" href={href('/en/contractors/')}>Containers for contractors</a>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container-page mt-14">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-2xl font-bold">Our containers on site</h2>
        <a class="text-sm font-semibold underline" href={href('/en/our-work/')}>All photos</a>
      </div>
      <div class="mt-5"><WorkGrid items={featured} lang="en" /></div>
    </section>
  )}

  <div class="container-page"><FAQ faqs={faqs} title="Frequently asked questions" /></div>
</BaseLayout>
