---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContainerCard from '../components/ContainerCard.astro';
import FAQ from '../components/FAQ.astro';
import { business, custom } from '../data/business';
import { waLink } from '../data/whatsapp';
import { containers } from '../lib/content';
import photo from '../content/works/images/hawiyat-anqad-12-metr-134.jpg';

const list = await containers();
const crumbs = [{ name: 'الرئيسية', path: '/' }, { name: custom.title, path: custom.path }];
const faqs = [
  { question: 'هل تفصّلون حاويات بمقاسات خاصة؟', answer: `نعم، ${business.name} تفصّل وتصمّم الحاوية بالمقاس الذي تطلبه الشركة.` },
  { question: 'ما المعلومات المطلوبة لتفصيل حاوية؟', answer: 'الأبعاد أو السعة المطلوبة، ونوع المخلفات التي ستوضع فيها، وعدد الحاويات، وموقع استخدامها.' },
  { question: 'كيف أطلب تفصيل حاوية؟', answer: `أرسل المقاس المطلوب وتفاصيل الاستخدام عبر واتساب ${business.whatsapp}، ونتواصل معك لتأكيد التصميم.` },
];
const wa = waLink(`مرحبًا ${business.short}، نريد تفصيل حاوية بمقاس خاص.\nاسم الشركة:\nالأبعاد أو السعة المطلوبة:\nنوع المخلفات:\nعدد الحاويات:`);
---
<BaseLayout
  title="تفصيل حاويات حسب الطلب بالمقاس المطلوب في الكويت"
  description={`${business.name} تفصّل وتصمّم حاويات المخلفات بالمقاس الذي تطلبه الشركات في الكويت. أرسل الأبعاد ونوع المخلفات عبر واتساب ${business.whatsapp}.`}
  faqs={faqs}
  breadcrumbs={crumbs}
  alternate={custom.pathEn}
  service={{ name: custom.title, url: new URL(Astro.url.pathname, Astro.site).toString(), description: custom.short }}
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} />
    <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_24rem]">
      <div>
        <h1 class="text-3xl font-bold leading-snug">تفصيل حاويات حسب الطلب بالمقاس الذي تحتاجه شركتك</h1>
        <p class="mt-4 text-lg">إلى جانب مقاسَي 12 و30 متر مكعب، نفصّل ونصمّم الحاوية بالمقاس الذي تطلبه الشركة، بما يناسب نوع المخلفات وطبيعة موقع العمل.</p>
        <h2 class="mt-8 text-xl font-bold">ما نحتاجه منك</h2>
        <ul class="mt-3 list-disc space-y-1 ps-6">
          <li>الأبعاد أو السعة المطلوبة</li>
          <li>نوع المخلفات التي ستوضع في الحاوية</li>
          <li>عدد الحاويات</li>
          <li>موقع الاستخدام</li>
        </ul>
        <a class="btn btn-wa mt-6" href={wa} target="_blank" rel="noopener">أرسل المقاس عبر واتساب</a>
      </div>
      <Image src={photo} alt="حاوية من تنظيفكو المحلية بعد التجهيز والطلاء" widths={[400, 640, 900]} sizes="(min-width: 1024px) 24rem, 100vw" class="w-full rounded-2xl object-cover" loading="eager" />
    </div>
    <FAQ faqs={faqs} />
    <section class="mt-12">
      <h2 class="text-2xl font-bold">المقاسات الجاهزة</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2">{list.map((c) => <ContainerCard c={c} />)}</div>
    </section>
  </div>
</BaseLayout>
