---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContainerCard from '../components/ContainerCard.astro';
import WorkGrid from '../components/WorkGrid.astro';
import FAQ from '../components/FAQ.astro';
import TrustBar from '../components/TrustBar.astro';
import { business, operations, priceFaq, areasFaq } from '../data/business';
import { waContainer } from '../data/whatsapp';
import { containers, works, dims, type Container } from '../lib/content';
import { href, abs } from '../lib/url';

export async function getStaticPaths() {
  const list = await containers();
  return list.map((c) => ({ params: { container: c.id }, props: { c } }));
}
const { c } = Astro.props as { c: Container };
const d = c.data;
const { Content } = await render(c);
const pageFaqs = [...d.faqs, priceFaq(business.whatsapp), areasFaq];
const others = (await containers()).filter((x) => x.id !== c.id);
const gallery = await works({ container: c.id });
const size = dims(c);
const url = abs(`/${c.id}/`, Astro.site);
const crumbs = [
  { name: 'الرئيسية', path: '/' },
  { name: d.title, path: `/${c.id}/` },
];
---
<BaseLayout
  title={d.seoTitle ?? d.h1}
  description={d.description}
  faqs={pageFaqs}
  alternate={`/en/${d.enSlug}/`}
  breadcrumbs={crumbs}
  service={{ name: d.title, url, description: d.description, image: d.image ? new URL(d.image.src, Astro.site).toString() : undefined }}
  ogImage={d.image?.src}
>
  <div class="container-page pt-6">
    <Breadcrumbs items={crumbs} />
    <div class="mt-4 grid gap-8 lg:grid-cols-[1fr_26rem]">
      <div>
        <h1 class="text-3xl font-bold leading-snug">{d.h1}</h1>
        <dl class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-xl border border-line bg-white p-4"><dt class="text-sm text-muted">السعة</dt><dd class="text-xl font-bold">{d.capacity} متر مكعب</dd></div>
          {size && <div class="rounded-xl border border-line bg-white p-4"><dt class="text-sm text-muted">الأبعاد (طول × عرض × ارتفاع)</dt><dd class="text-xl font-bold">{size}</dd></div>}
          <div class="rounded-xl border border-line bg-white p-4 sm:col-span-2"><dt class="text-sm text-muted">المخلفات المناسبة</dt><dd class="font-bold">{d.accepts.join('، ')}</dd>{d.notFor && <dd class="mt-1 text-sm text-muted">{d.notFor}</dd>}</div>
        </dl>
        <div class="prose-ar mt-5 text-lg"><Content /></div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-wa" href={waContainer(d.title)} target="_blank" rel="noopener">اطلب {d.title} عبر واتساب</a>
          <a class="btn btn-line" href={href('/talab-hawiya/')}>نموذج الطلب</a>
        </div>
        <div class="mt-5"><TrustBar tone="light" /></div>
      </div>
      {d.image && (
        <Image src={d.image} alt={d.imageAlt ?? d.title} widths={[480, 720, 960]} sizes="(min-width: 1024px) 26rem, 100vw" class="w-full rounded-2xl object-cover" loading="eager" fetchpriority="high" />
      )}
    </div>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">التوصيل والتبديل والرفع</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-3">
        {operations.map((o) => <li class="rounded-xl border border-line bg-white p-5"><h3 class="font-bold">{o.title}</h3><p class="mt-1 text-sm text-muted">{o.text}</p></li>)}
      </ul>
    </section>

    {gallery.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold">صور {d.title} في مواقع العمل</h2>
        <div class="mt-5"><WorkGrid items={gallery.slice(0, 6)} /></div>
      </section>
    )}

    <FAQ faqs={pageFaqs} />

    {others.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold">الحاوية الأخرى</h2>
        <p class="mt-1 text-muted">للمقارنة بين المقاسات: <a class="text-brand underline" href={href('/maqasat-hawiyat/')}>دليل مقاسات حاويات الأنقاض</a>.</p>
        <div class="mt-5 grid gap-5 md:grid-cols-2">{others.map((o) => <ContainerCard c={o} />)}</div>
      </section>
    )}
  </div>
</BaseLayout>
